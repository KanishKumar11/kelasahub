# MongoDB connection string (MongoDB Atlas free tier works well)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kelasahub

# Long random string used to sign admin sessions: `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-string

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@kelasahub.in
ADMIN_PASSWORD=ChangeMe@123

# Public URL (used in SEO tags, sitemap and PDFs)
NEXT_PUBLIC_SITE_URL=https://kelasahub.in

# SMTP — REQUIRED in production. Sends email verification codes (job applications and
# the status tracker), application confirmations and selection emails.
# Google Workspace / Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = an App Password
# Zoho Mail:                SMTP_HOST=smtp.zoho.in,   SMTP_PORT=465
# Hostinger:                SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465
# In development, if these are empty, codes are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=support@kelasahub.in
SMTP_PASS=
SMTP_FROM="KelasaHub <support@kelasahub.in>"
